# RxForge Multi-Provider Configuration (@mariozechner/pi-ai)
# Provide whichever provider key(s) you use. OpenRouter can power both Writer & Critic with one key!

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Heterogeneous Writer vs. Blind Critic models (prevents single-model blind spots)
RXFORGE_WRITER_PROVIDER=anthropic
RXFORGE_WRITER_MODEL=claude-sonnet-4-5

RXFORGE_CRITIC_PROVIDER=openai
RXFORGE_CRITIC_MODEL=gpt-4.1

# Optional openFDA API key for higher rate limits (works without key up to 240 req/min)
OPENFDA_API_KEY=
